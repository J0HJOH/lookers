{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lookers (phone or simulator, with Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "frontend",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=env.json"]
    },
    {
      "name": "Lookers (web on port 3000, with Supabase)",
      "request": "launch",
      "type": "dart",
      "cwd": "frontend",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port=3000", "--dart-define-from-file=env.json"]
    }
  ]
}
