# Copy to .env.local and fill in. Never commit .env.local.
# Step-by-step instructions: docs/SETUP.md

# Public site address (no trailing slash). Production: your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD

# Supabase > Project Settings > API (both are safe for the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mailgun (SERVER ONLY: never prefix with NEXT_PUBLIC_)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Optional. Defaults to "Lookers <orders@MAILGUN_DOMAIN>"
MAILGUN_FROM=
# Optional. Use https://api.eu.mailgun.net for EU-region domains
MAILGUN_API_BASE=
